# --- Monorepo root .gitignore (Stockfish's original ignore was moved to
#     engine/Stockfish/.gitignore as part of the restructure.) ---

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
**/*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Env
.env
.env.*
!.env.example

# Emscripten SDK (engine build toolchain — not committed)
engine/emsdk/
engine/Stockfish/src/.emcache/

# Compiled WASM artifacts (regenerated via `pnpm engine:build`)
apps/web/public/engine/stockfish.js
apps/web/public/engine/stockfish.wasm
apps/web/public/engine/stockfish.worker.js

# Testing
coverage/

# Husky binaries are installed locally
.husky/_

next-env.d.ts

# Large binary files (use LFS or download separately)
apps/web/public/engine/*.wasm
*.wasm
