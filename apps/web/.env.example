# ---------- Supabase ----------
# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public/anon key (a.k.a. "publishable key" in newer Supabase dashboards).
# Either of these names is accepted.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Service-role key — SERVER-ONLY. Never expose to the browser.
# Used only by code in apps/web/src/lib/supabase/admin.ts
SUPABASE_SERVICE_ROLE_KEY=

# ---------- App ----------
# Public URL the app is served on (used to build OAuth redirect URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
